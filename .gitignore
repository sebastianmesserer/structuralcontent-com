# Worker: the prompts are IP — bundled into the Worker at deploy time, never
# committed. Ignore the whole directory (not just system-prompt.md): this repo is
# public, and a ported multi-stage engine adds prompt files that would otherwise
# be tracked by default. Only the explanatory README is in git.
worker/prompts/*
!worker/prompts/README.md
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
